{
  "name": "game-ai-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply game_ai_player --local",
    "db:remote": "wrangler d1 migrations apply game_ai_player --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^3.107.0"
  },
  "dependencies": {
    "hono": "^4.6.20"
  }
}
